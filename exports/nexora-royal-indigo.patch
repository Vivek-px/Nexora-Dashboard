@@ -0,0 +1,303 @@
+"""Indi: the roaming Nexora companion, rendered as a presentation-only overlay.
+
+The component mounts a single floating layer into the Streamlit page (same-origin ``st.iframe``)
+and reacts to real interface events on existing elements: KPI cards, Plotly charts, the priority
+evidence review and the action queue. It only quotes text that is already on screen and never claims
+to have run analysis. No data, model or session state is read or modified.
+"""
+import json
+
+import streamlit as st
+
+from dashboard import theme
+
+_SCRIPT = r"""
+<script>
+(function () {
+  const P = window.parent, D = P.document;
+  if (!D || D.getElementById('indi-root')) return;  // already mounted for this browser session
+  const C = __TOKENS__;
+  const reduced = () => P.matchMedia('(prefers-reduced-motion: reduce)').matches;
+  const store = P.sessionStorage;
+  let quiet = store.getItem('indi-quiet') === '1';
+  let hidden = true, pos = {x: 40, y: 40}, anim = 0, target = null, lastMove = 0, bubbleOpen = false;
+
+  const css = D.createElement('style');
+  css.textContent = `
+  #indi-root{position:fixed;inset:0;pointer-events:none;z-index:999990;font-family:Inter,'Segoe UI',sans-serif}
+  #indi-bot{position:absolute;left:0;top:0;width:56px;height:60px;pointer-events:auto;cursor:pointer;border:0;background:none;padding:0;
+    filter:drop-shadow(0 6px 10px rgba(10,6,40,.5));transition:opacity 300ms ease,scale 320ms cubic-bezier(.2,.8,.3,1)}
+  #indi-bot.is-hidden{opacity:0;scale:.25;pointer-events:none}
+  #indi-bot svg{transform:rotate(var(--tilt,0deg));transition:transform 160ms ease-out}
+  #indi-bot.float svg{animation:indi-float 3.6s ease-in-out infinite}
+  #indi-bot.hop svg{animation:indi-hop 700ms ease-in-out 1}
+  #indi-bot:focus-visible{outline:2px solid ${C.CYAN};outline-offset:4px;border-radius:50%}
+  #indi-shadow{position:absolute;left:11px;bottom:-8px;width:34px;height:7px;border-radius:50%;background:radial-gradient(rgba(8,5,35,.55),transparent 70%)}
+  @keyframes indi-float{50%{transform:translateY(-4px)}}
+  @keyframes indi-hop{35%{transform:translateY(-8px) rotate(-5deg)}65%{transform:translateY(-3px) rotate(4deg)}}
+  #indi-bubble{position:absolute;left:0;top:0;width:270px;pointer-events:auto;background:${C.MIDNIGHT};border:1px solid rgba(169,155,255,.35);border-radius:12px;
+    padding:12px 13px;color:${C.TEXT};font-size:13px;line-height:1.45;box-shadow:0 14px 30px -12px rgba(6,4,30,.9);animation:indi-in 190ms ease-out}
+  @keyframes indi-in{from{opacity:0;translate:0 5px}to{opacity:1;translate:0 0}}
+  #indi-bubble .hd{display:flex;align-items:center;gap:8px;margin-bottom:4px}
+  #indi-bubble .nm{font-size:10px;font-weight:700;letter-spacing:.14em;color:${C.ORCHID_SOFT}}
+  #indi-bubble .x{margin-left:auto;background:none;border:0;color:${C.MUTED};cursor:pointer;font-size:15px;line-height:1;padding:2px 4px;border-radius:6px}
+  #indi-bubble .x:hover{color:#fff;background:rgba(255,255,255,.08)}
+  #indi-bubble .chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}
+  #indi-bubble .chip{border:1px solid rgba(106,140,240,.55);background:rgba(49,92,232,.22);color:#fff;border-radius:999px;padding:4px 10px;font-size:11px;cursor:pointer;transition:background-color 200ms}
+  #indi-bubble .chip:hover{background:rgba(49,92,232,.45)}
+  #indi-bubble .ft{margin-top:10px;font-size:10.5px;color:${C.DIM};display:flex;justify-content:space-between}
+  #indi-bubble .ft button{background:none;border:0;color:${C.MUTED};cursor:pointer;font-size:10.5px;padding:0}
+  #indi-bubble .ft button:hover{color:#fff}
+  #indi-tail{position:absolute;width:10px;height:10px;background:${C.MIDNIGHT};transform:rotate(45deg)}
+  .brand-mark{cursor:pointer;position:relative}
+  .brand-mark::after{content:"";position:absolute;top:-3px;right:-3px;width:8px;height:8px;border-radius:50%;background:${C.CYAN};box-shadow:0 0 0 2px ${C.INDIGO}}
+  @media (prefers-reduced-motion: reduce){#indi-bot.float svg,#indi-bot.hop svg{animation:none}#indi-bubble{animation-duration:1ms}}`;
+  D.head.appendChild(css);
+
+  const root = D.createElement('div'); root.id = 'indi-root'; root.setAttribute('aria-live', 'polite');
+  root.innerHTML = `<button id="indi-bot" class="is-hidden" type="button" aria-label="Indi assistant. Press Enter to open suggestions." tabindex="-1">
+    <span id="indi-shadow"></span>${robot()}</button>`;
+  D.body.appendChild(root);
+  const bot = root.querySelector('#indi-bot');
+
+  function robot() {
+    return `<svg viewBox="0 0 56 60" width="56" height="60" aria-hidden="true" style="overflow:visible">
+      <defs><radialGradient id="ib" cx="35%" cy="28%" r="80%"><stop offset="0%" stop-color="#fff"/><stop offset="55%" stop-color="${C.SOFT}"/><stop offset="100%" stop-color="#BDB2F5"/></radialGradient></defs>
+      <line x1="28" y1="9" x2="28" y2="3.5" stroke="${C.VIOLET}" stroke-width="1.6" stroke-linecap="round"/>
+      <circle id="ia" cx="28" cy="3" r="2.2" fill="${C.CYAN}"/>
+      <ellipse cx="7" cy="36" rx="3.2" ry="5" fill="url(#ib)" stroke="${C.LAVENDER}" stroke-width=".6"/>
+      <g id="iarm"><ellipse cx="49" cy="36" rx="3.2" ry="5" fill="url(#ib)" stroke="${C.LAVENDER}" stroke-width=".6"/></g>
+      <g id="imag" style="display:none"><circle cx="49" cy="26" r="4" fill="none" stroke="${C.CYAN}" stroke-width="1.6"/><line x1="46.5" y1="29" x2="44" y2="32.5" stroke="${C.VIOLET}" stroke-width="1.8" stroke-linecap="round"/></g>
+      <ellipse cx="28" cy="46" rx="13" ry="9" fill="url(#ib)" stroke="${C.LAVENDER}" stroke-width=".6"/>
+      <circle cx="28" cy="46" r="2.6" fill="${C.ORCHID}"/><circle cx="28" cy="46" r="1" fill="${C.GOLD}"/>
+      <rect x="9" y="9" width="38" height="30" rx="15" fill="url(#ib)" stroke="${C.LAVENDER}" stroke-width=".6"/>
+      <rect x="9" y="22" width="3" height="7" rx="1.5" fill="${C.VIOLET}"/><rect x="44" y="22" width="3" height="7" rx="1.5" fill="${C.VIOLET}"/>
+      <rect x="14" y="15" width="28" height="18" rx="9" fill="${C.INDIGO}"/>
+      <g id="ieyes"><ellipse id="iel" cx="21.5" cy="24" rx="3.2" ry="3.6" fill="${C.SAPPHIRE}"/><ellipse id="ier" cx="34.5" cy="24" rx="3.2" ry="3.6" fill="${C.SAPPHIRE}"/>
+        <circle cx="22.6" cy="22.6" r="1" fill="#A5F3FC"/><circle cx="35.6" cy="22.6" r="1" fill="#A5F3FC"/></g>
+      <circle cx="16.5" cy="30.5" r="1.6" fill="${C.ORCHID}" opacity=".55"/><circle cx="39.5" cy="30.5" r="1.6" fill="${C.ORCHID}" opacity=".55"/>
+      <path id="imouth" d="M25.5 29.3 q2.5 1.8 5 0" stroke="${C.CYAN}" stroke-width="1" fill="none" stroke-linecap="round"/>
+    </svg>`;
+  }
+
+  // ---- mood -------------------------------------------------------------------------
+  function mood(m) {
+    const a = root.querySelector('#ia'), arm = root.querySelector('#iarm'), mag = root.querySelector('#imag'),
+          l = root.querySelector('#iel'), r = root.querySelector('#ier'), mouth = root.querySelector('#imouth');
+    a.setAttribute('fill', quiet ? C.DIM : {investigate: C.AMBER, concerned: C.CORAL_ROSE, happy: C.EMERALD}[m] || C.CYAN);
+    mag.style.display = m === 'investigate' ? '' : 'none';
+    arm.setAttribute('transform', m === 'point' ? 'rotate(-70 49 36)' : '');
+    const ry = quiet ? 1 : m === 'investigate' ? 1.6 : 3.6;
+    l.setAttribute('ry', m === 'investigate' ? 1.6 : ry); r.setAttribute('ry', ry);
+    mouth.setAttribute('d', m === 'concerned' ? 'M25.5 30.5 q2.5 -1.6 5 0' : 'M25.5 29.3 q2.5 1.8 5 0');
+    bot.classList.toggle('hop', m === 'happy');
+  }
+
+  // ---- geometry ---------------------------------------------------------------------
+  function canvas() {
+    const m = D.querySelector('[data-testid="stMain"]') || D.querySelector('section.main') || D.body;
+    return m.getBoundingClientRect();
+  }
+  function clamp(p) {
+    const m = canvas(), h = 36;
+    return {x: Math.min(Math.max(p.x, m.left + h), Math.min(m.right, P.innerWidth) - h),
+            y: Math.min(Math.max(p.y, Math.max(m.top, 0) + 70), Math.min(m.bottom, P.innerHeight) - h)};
+  }
+  function anchorFor(el) {
+    const r = el.getBoundingClientRect();
+    if (r.top - 34 > 80) return clamp({x: r.right - 26, y: r.top - 24});  // peek over the card's top edge
+    return clamp({x: r.right + 40 < P.innerWidth ? r.right + 32 : r.left - 32, y: r.top + 36});
+  }
+  function logo() {
+    const b = D.querySelector('.brand-mark');
+    const r = b && b.getBoundingClientRect();
+    return r && r.width ? {x: r.left + r.width / 2, y: r.top + r.height / 2} : {x: 40, y: 40};
+  }
+  function place(p) { pos = p; bot.style.transform = `translate(${p.x - 28}px, ${p.y - 30}px)`; positionBubble(); }
+  const ease = t => t < .5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
+  function travel(to, opt = {}) {
+    if (!opt.free) to = clamp(to);
+    P.cancelAnimationFrame(anim);
+    const from = pos, dist = Math.hypot(to.x - from.x, to.y - from.y);
+    if (reduced() || dist < 2) { place(to); opt.done && opt.done(); return; }
+    const dur = opt.dur || Math.min(650, Math.max(350, 350 + dist * .35));
+    const c = opt.swoop ? {x: to.x + (from.x - to.x) * .25, y: to.y + (from.y - to.y) * .85}
+                        : {x: (from.x + to.x) / 2, y: Math.min(from.y, to.y) - Math.min(90, dist * .25)};
+    const t0 = P.performance.now();
+    const step = now => {
+      const t = ease(Math.min(1, (now - t0) / dur)), u = 1 - t;
+      place({x: u*u*from.x + 2*u*t*c.x + t*t*to.x, y: u*u*from.y + 2*u*t*c.y + t*t*to.y});
+      if (t < 1) anim = P.requestAnimationFrame(step); else opt.done && opt.done();
+    };
+    anim = P.requestAnimationFrame(step);
+  }
+  function goTo(el, force) {
+    if (hidden || ((quiet || reduced()) && !force)) return;
+    target = el; lastMove = Date.now();
+    if (!quiet) travel(el ? anchorFor(el) : clamp({x: canvas().right - 70, y: P.innerHeight - 90}));
+  }
+
+  // ---- bubble -----------------------------------------------------------------------
+  let bubble = null;
+  function say(msg, chips = [], m = 'curious') {
+    if (hidden) return;
+    close(false);
+    mood(m);
+    bubble = D.createElement('div'); bubble.id = 'indi-bubble'; bubble.setAttribute('role', 'dialog'); bubble.setAttribute('aria-label', 'Indi suggestion');
+    bubble.innerHTML = `<span id="indi-tail"></span><div class="hd"><span class="nm">INDI</span><button class="x" aria-label="Dismiss">×</button></div>
+      <div class="msg"></div><div class="chips"></div>
+      <div class="ft"><span>Quotes on-screen values only</span><button class="q">${quiet ? 'Resume roaming' : 'Quiet mode'}</button></div>`;
+    bubble.querySelector('.msg').textContent = msg;
+    const box = bubble.querySelector('.chips');
+    chips.forEach(([label, run]) => { const b = D.createElement('button'); b.className = 'chip'; b.textContent = label; b.onclick = run; box.appendChild(b); });
+    if (!chips.length) box.remove();
+    bubble.querySelector('.x').onclick = () => close();
+    bubble.querySelector('.q').onclick = toggleQuiet;
+    root.appendChild(bubble); bubbleOpen = true; positionBubble();
+  }
+  function close(rest = true) { if (bubble) bubble.remove(); bubble = null; bubbleOpen = false; if (rest) mood('idle'); }
+  function positionBubble() {
+    if (!bubble) return;
+    const W = 270, h = bubble.offsetHeight || 140, m = canvas(), left = pos.x - 42 - W > Math.max(m.left, 0) + 8;
+    const x = left ? pos.x - 42 - W : pos.x + 42;
+    const y = Math.min(Math.max(pos.y - 40, 8), P.innerHeight - h - 8);
+    bubble.style.transform = `translate(${x}px, ${y}px)`;
+    const tail = bubble.querySelector('#indi-tail');
+    tail.style.top = Math.min(Math.max(pos.y - y - 6, 14), h - 20) + 'px';
+    tail.style.left = left ? (W - 6) + 'px' : '-6px';
+    tail.style.borderRight = left ? '1px solid rgba(169,155,255,.35)' : ''; tail.style.borderTop = left ? '1px solid rgba(169,155,255,.35)' : '';
+    tail.style.borderLeft = left ? '' : '1px solid rgba(169,155,255,.35)'; tail.style.borderBottom = left ? '' : '1px solid rgba(169,155,255,.35)';
+  }
+  function toggleQuiet() {
+    quiet = !quiet; store.setItem('indi-quiet', quiet ? '1' : '0');
+    bot.classList.toggle('float', !quiet && !reduced());
+    say(quiet ? 'Quiet mode on. I will stay here until you need me.' : "I'm back and will follow what you explore.", [], 'idle');
+    setTimeout(() => close(), 2200);
+  }
+  const clickNav = label => { const b = D.querySelector(`.st-key-nav_${label.replace(/[^A-Za-z0-9_-]/g, '-')} button`); b && b.click(); close(); };
+  const text = (el, sel) => ((el.querySelector(sel) || {}).textContent || '').trim();
+
+  // ---- summon / hide from the brand mark --------------------------------------------
+  function summon() {
+    hidden = false; bot.classList.remove('is-hidden'); bot.tabIndex = 0;
+    bot.classList.toggle('float', !quiet && !reduced());
+    place(logo()); lastMove = Date.now();
+    P.requestAnimationFrame(() => travel({x: canvas().left + 120, y: 230}));
+    mood('curious');
+    setTimeout(() => say("Hi, I'm Indi. I'll point things out as you explore. Everything I mention comes from what's on screen.",
+      [['Open action queue', () => clickNav('Recommendations')], ['Back to the logo', retire]]), 700);
+  }
+  function retire() {
+    close(); hidden = true; target = null; bot.tabIndex = -1;
+    travel(logo(), {free: true, swoop: true, dur: 760, done: () => bot.classList.add('is-hidden')});
+    setTimeout(() => bot.classList.add('is-hidden'), 140);
+  }
+  D.addEventListener('click', e => {
+    if (e.target.closest && e.target.closest('.brand-mark')) { hidden ? summon() : retire(); }
+  });
+
+  // ---- real interface events --------------------------------------------------------
+  let hoverT = 0;
+  D.addEventListener('pointerover', e => {
+    const el = e.target.closest && e.target.closest('.kpi, .executive-kpi');
+    P.clearTimeout(hoverT);
+    if (!el || hidden || quiet || el === target) return;
+    hoverT = P.setTimeout(() => {
+      if (Date.now() - lastMove < 2500) return;
+      const label = text(el, '.kpi-label'), value = text(el, '.kpi-value');
+      const note = text(el, '.kpi-detail') || text(el, '.kpi-change');
+      const src = text(el, '.evidence-badge') || text(el, '.kpi-source');
+      goTo(el);
+      say(`${label} shows ${value}${src ? ` (${src})` : ''}. Want to look at its trend?`,
+        [['Explain the label', () => say(note ? `${label}: ${note}` : `${label} has no further detail on this card.`, [], 'idle')],
+         ['Open Domain Intelligence', () => clickNav('Domain Intelligence')]]);
+    }, 900);
+  });
+  D.addEventListener('click', e => {
+    if (hidden || !e.target.closest || e.target.closest('#indi-root')) return;
+    const chart = e.target.closest('[data-testid="stPlotlyChart"]');
+    const action = e.target.closest('.summary-action');
+    if (chart) {
+      goTo(chart, true);
+      say('Want to explore this chart? Hover a point for its dated source and classification. Forecast ranges are empirical error envelopes, not guarantees.',
+        [['Forecasts & Anomalies', () => clickNav('Forecasts & Anomalies')], ['Data & Methodology', () => clickNav('Data & Methodology')]], 'point');
+    } else if (action) {
+      goTo(action, true);
+      const strong = text(action, 'strong');
+      const high = /high|critical|1\b/i.test(strong);
+      say(`This review item is "${strong}". It is a statistical screening result to verify, not a confirmed fault.`,
+        [['Open action queue', () => clickNav('Recommendations')]], high ? 'concerned' : 'investigate');
+    }
+  }, true);
+
+  // Successful saves / resets surface as Streamlit toasts or success alerts.
+  new P.MutationObserver(muts => {
+    if (hidden) return;
+    for (const m of muts) for (const n of m.addedNodes) {
+      if (n.nodeType === 1 && (n.matches?.('[data-testid="stToast"], [data-testid="stAlertContentSuccess"]') || n.querySelector?.('[data-testid="stAlertContentSuccess"]'))) {
+        say('Done. That change went through.', [], 'happy'); setTimeout(() => close(), 2200); return;
+      }
+    }
+  }).observe(D.body, {childList: true, subtree: true});
+
+  // Page changes: move toward the first chart or KPI row of the new page.
+  let lastHeading = '';
+  P.setInterval(() => {
+    if (hidden) return;
+    const h = text(D, '.page-intro h1');
+    if (h && h !== lastHeading) {
+      const first = !lastHeading; lastHeading = h;
+      if (!first && !bubbleOpen) P.setTimeout(() => goTo(D.querySelector('[data-testid="stPlotlyChart"], .executive-kpi, .kpi')), 600);
+    }
+    if (target && !target.isConnected) target = null;
+  }, 800);
+
+  // Follow the target while scrolling; keep within the canvas on resize.
+  const sync = () => { if (hidden) return; if (target && target.isConnected) {
+      const r = target.getBoundingClientRect();
+      if (r.bottom < 60 || r.top > P.innerHeight - 40) { target = null; } else if (!quiet) place(anchorFor(target));
+    } else place(clamp(pos)); };
+  D.addEventListener('scroll', () => P.requestAnimationFrame(sync), {capture: true, passive: true});
+  P.addEventListener('resize', sync);
+
+  // Infrequent, purposeful patrol between visible KPIs and charts.
+  P.setInterval(() => {
+    if (hidden || quiet || reduced() || bubbleOpen || D.hidden || Date.now() - lastMove < 9000) return;
