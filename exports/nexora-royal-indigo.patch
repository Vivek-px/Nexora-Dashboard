+  }, 12000);
+
+  // Eye tracking and proximity tilt.
+  D.addEventListener('pointermove', e => {
+    if (hidden) return;
+    const dx = e.clientX - pos.x, dy = e.clientY - pos.y, d = Math.hypot(dx, dy) || 1, k = Math.min(1, d / 160);
+    root.querySelector('#ieyes').setAttribute('transform', `translate(${(dx / d * 2.4 * k).toFixed(2)} ${(dy / d * 1.8 * k).toFixed(2)})`);
+    bot.style.setProperty('--tilt', d < 120 ? `${(dx / d * 6).toFixed(1)}deg` : '0deg');
+  }, {passive: true});
