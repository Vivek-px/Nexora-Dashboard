-.summary-note{font-size:13px;line-height:1.65;color:#475569;margin-top:8px}.summary-action{border-left:3px solid #4338CA;background:#F8FAFC;padding:11px 12px;border-radius:5px;font-size:13px;line-height:1.6}
-.stButton button,.stDownloadButton button{border:1px solid #CBD5E1;border-radius:8px;background:#FFFFFF;color:#334155;min-height:42px;font-size:14px}
-.stButton button:hover,.stDownloadButton button:hover{border-color:var(--accent);color:var(--accent);background:#EEF2FF}
-.stButton button[kind="primary"]{background:var(--accent);color:white;border-color:var(--accent)}
-button:focus-visible,input:focus-visible,[role="combobox"]:focus-visible{outline:2px solid var(--accent)!important;outline-offset:3px}
-[data-testid="stDataFrame"]{border:1px solid var(--line);border-radius:8px;overflow:hidden}
-.water-scope-note{background:#FFFBEB;border:1px solid #FDE68A;border-radius:8px;padding:14px;color:#92400E;font-size:14px;line-height:1.6;margin:12px 0}
-.footer{border-top:1px solid var(--line);padding-top:16px;margin-top:26px;color:var(--muted);font-size:12px;line-height:1.6}
+.panel-heading{font-size:15px;font-weight:650;color:var(--white);display:flex;justify-content:space-between;gap:10px;line-height:1.5}.panel-heading span{font-size:12.5px;font-weight:400;color:var(--muted)}
+.panel-caption{font-size:12.5px;color:var(--muted);line-height:1.6;margin:6px 0 14px}
+.summary-title{font-size:11px;font-weight:650;letter-spacing:.08em;text-transform:uppercase;color:var(--dim);margin:14px 0 6px}
+.summary-reading{display:flex;justify-content:space-between;gap:12px;padding:7px 0;border-bottom:1px solid var(--divider);font-size:13.5px;color:var(--muted)}.summary-reading strong{color:var(--white);white-space:nowrap;font-variant-numeric:tabular-nums}
+.summary-note{font-size:13px;line-height:1.6;color:var(--muted);margin-top:8px}
+.summary-action{border-left:3px solid var(--orchid);background:rgba(50,21,60,.55);padding:11px 12px;border-radius:6px;font-size:13px;line-height:1.6;color:var(--soft)}
+
+/* Layer 4 · interactive highlights */
+.stButton button,.stDownloadButton button,.stLinkButton a{border:1px solid var(--line);border-radius:9px;background:rgba(232,227,250,.04);color:var(--soft);min-height:40px;font-size:13.5px;transition:background-color 200ms ease,border-color 200ms ease,color 200ms ease}
+.stButton button:hover,.stDownloadButton button:hover,.stLinkButton a:hover{border-color:var(--sapphire-soft);color:var(--white);background:rgba(49,92,232,.16)}
+.stButton button[kind="primary"]{background:var(--sapphire);color:var(--white);border-color:var(--sapphire)}
+.stButton button[kind="primary"]:hover{background:#3D68F0;border-color:#3D68F0}
+.stButton button:disabled,.stDownloadButton button:disabled{color:var(--disabled);border-color:var(--divider);background:transparent}
+button:focus-visible,input:focus-visible,a:focus-visible,[role="combobox"]:focus-visible{outline:2px solid var(--cyan)!important;outline-offset:3px}
+[data-baseweb="select"]>div,[data-baseweb="input"]>div{background:var(--slate)!important;border-color:var(--line)!important}
+[data-baseweb="tag"]{background:rgba(49,92,232,.3)!important;color:var(--white)!important}
+[data-baseweb="popover"] ul{background:var(--slate)!important}
+[data-testid="stSlider"] [role="slider"]{background:var(--white)!important;box-shadow:0 0 0 4px rgba(49,92,232,.35)}
+[data-testid="stExpander"] details{background:var(--slate);border:1px solid rgba(169,155,255,.16)!important;border-radius:12px}
+[data-testid="stDataFrame"]{border:1px solid var(--line);border-radius:10px;overflow:hidden}
+[data-testid="stPlotlyChart"]{border-radius:12px;transition:box-shadow 220ms ease}
+[data-testid="stPlotlyChart"]:hover{box-shadow:0 0 0 1px rgba(106,140,240,.28)}
+[data-testid="stAlert"]{border-radius:10px}
+.water-scope-note{background:rgba(245,184,75,.10);border:1px solid rgba(245,184,75,.35);border-radius:10px;padding:14px;color:#F8D79A;font-size:13.5px;line-height:1.6;margin:12px 0}
+.footer{border-top:1px solid var(--divider);padding-top:16px;margin-top:26px;color:var(--dim);font-size:12px;line-height:1.6}
