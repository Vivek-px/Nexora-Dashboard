--- /dev/null
+++ b/dashboard/theme.py
@@ -0,0 +1,74 @@
+"""Royal Indigo design tokens shared by CSS, Plotly figures and the Indi companion.
+
+Presentation only: nothing here touches data, models or calculations.
+"""
+import plotly.graph_objects as go
+import plotly.io as pio
+
+# Foundation
+INDIGO = '#17143B'
+MIDNIGHT = '#1D3159'
+PLUM = '#32153C'
+SLATE = '#252249'
+RAISED = '#2E2A5A'
+LINE = '#3B3677'
+# Interaction and AI
+SAPPHIRE = '#315CE8'
+VIOLET = '#7767D9'
+ORCHID = '#B65CB9'
+LAVENDER = '#A99BFF'
+# Analytical accents
+TEAL_BLUE = '#4E7F95'
+TEAL_SOFT = '#7FB0C5'
+TEAL_CYAN = '#5FC7D8'
+SAPPHIRE_SOFT = '#6A8CF0'
+CYAN = '#42D9F5'
+GOLD = '#E6C477'
+# Text
+WHITE = '#FFFFFF'
+TEXT = '#F3F0FF'
+SOFT = '#E8E3FA'
+MUTED = '#B8B2D2'
+DIM = '#918BAF'
+# Status
+EMERALD = '#43D6A0'
+AMBER = '#F5B84B'
+CORAL_ROSE = '#FF6B7A'
+CORAL = '#FF9A76'
+
+#: Per-area series colours: consistent wherever the three localities are compared.
+AREA_COLORWAY = [CYAN, LAVENDER, GOLD]
+#: Selected / unselected map markers.
+MARKER_SELECTED = GOLD
+MARKER_DEFAULT = LAVENDER
+FORECAST = LAVENDER
+FORECAST_BAND = 'rgba(169,155,255,.14)'
+SCENARIO = AMBER
+GRID = 'rgba(232,227,250,.08)'
+
+#: Offline map style: an indigo canvas that needs no network tiles.
+OFFLINE_MAP_STYLE = {'version': 8, 'sources': {}, 'layers': [
+    {'id': 'background', 'type': 'background', 'paint': {'background-color': MIDNIGHT}}]}
+
+
+def map_style(tiles):
+    """Dark street tiles when online tiles are requested, otherwise the offline canvas."""
+    return 'carto-darkmatter' if tiles else OFFLINE_MAP_STYLE
+
+
+HOVER = dict(bgcolor=SLATE, bordercolor=LAVENDER, font=dict(color=TEXT, size=12, family='Inter, Segoe UI, sans-serif'))
+
+
+def register_plotly_template():
+    """Make every figure inherit the Royal Indigo look unless it sets a colour explicitly."""
+    axis = dict(gridcolor=GRID, zerolinecolor=GRID, linecolor=LINE, tickcolor=LINE,
+                tickfont=dict(color=MUTED, size=11), title=dict(font=dict(color=MUTED, size=12)))
+    pio.templates['royal_indigo'] = go.layout.Template(layout=dict(
+        font=dict(family='Inter, Segoe UI, sans-serif', color=SOFT, size=12),
+        paper_bgcolor='rgba(0,0,0,0)', plot_bgcolor='rgba(0,0,0,0)',
+        colorway=AREA_COLORWAY + [TEAL_SOFT, ORCHID, EMERALD, CORAL],
+        xaxis=axis, yaxis=axis, hoverlabel=HOVER,
+        legend=dict(font=dict(color=SOFT, size=11), bgcolor='rgba(0,0,0,0)'),
+        title=dict(font=dict(color=WHITE)),
+    ))
+    pio.templates.default = 'plotly_dark+royal_indigo'
